{
	"name": "workout_logger",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.8.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "pnpm run test:unit -- --run && pnpm run test:e2e",
		"test:e2e": "playwright test",
		"build:icons": "svg-sprite -s --symbol-dest=static --symbol-sprite=icons.svg src/lib/assets/icons/*.svg",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:reset-password": "tsx --env-file-if-exists=.env scripts/reset-password.ts"
	},
	"dependencies": {
		"@fontsource/russo-one": "^5.3.0",
		"@libsql/client": "^0.18.0",
		"better-auth": "^1.7.14",
		"dexie": "^4.4.7",
		"drizzle-orm": "^0.45.4",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@lucide/svelte": "^1.63.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.6.5",
		"bits-ui": "^2.20.2",
		"cn": "^0.5.0",
		"drizzle-kit": "^0.31.11",
		"fake-indexeddb": "^6.2.6",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.7.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"svg-sprite": "^2.0.4",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
