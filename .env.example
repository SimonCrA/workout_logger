# Base libSQL del servidor: Turso en producción, un archivo local en desarrollo y tests.
TURSO_DATABASE_URL=file:local.db
# Token de Turso; vacío con un archivo local.
TURSO_AUTH_TOKEN=
# Secreto con que Better Auth firma las sesiones (openssl rand -base64 32). Obligatorio en producción.
BETTER_AUTH_SECRET=
